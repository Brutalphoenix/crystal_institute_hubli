{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/courses/banking",
      "dest": "/courses/banking.html"
    },
    {
      "src": "/courses/ssc",
      "dest": "/courses/ssc.html"
    },
    {
      "src": "/courses/rrb",
      "dest": "/courses/rrb.html"
    },
    {
      "src": "/courses/pg-cet",
      "dest": "/courses/pg-cet.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/courses",
      "dest": "/courses.html"
    },
    {
      "src": "/why-cics",
      "dest": "/why-cics.html"
    },
    {
      "src": "/results",
      "dest": "/results.html"
    },
    {
      "src": "/faculty",
      "dest": "/faculty.html"
    },
    {
      "src": "/gallery",
      "dest": "/gallery.html"
    },
    {
      "src": "/testimonials",
      "dest": "/testimonials.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
